# Copy this file to .env and adjust the values for your machine (optional).
# All settings have sensible defaults and can be left empty.

# Directory where downloaded WAV files are saved (defaults to ./youtubedownloads)
# DOWNLOAD_DIR=./youtubedownloads

# Folder containing the ffmpeg binaries. Leave empty if ffmpeg / yt-dlp are on PATH.
# Windows (WinGet) default is used when this is unset.
# FFMPEG_DIR=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0-full_build\bin

# Folder containing the deno binary (yt-dlp uses it for the ejs remote component).
# Windows default is C:\Users\you\.deno\bin
# DENO_BIN_DIR=C:\Users\you\.deno\bin
